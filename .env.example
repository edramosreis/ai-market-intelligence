# Configuration contract: placeholders only, never actual values.
# Prefer `python scripts/init_local_env.py` to generate an ignored local .env.
# Defaults: market_intelligence, 127.0.0.1, port 55432, and three distinct roles.
# Compose overrides the host/port inside job containers to db:5432.
# Shared local database configuration.
POSTGRES_DB=REPLACE_WITH_LOCAL_DATABASE_NAME
POSTGRES_HOST=REPLACE_WITH_DATABASE_HOST
POSTGRES_PORT=REPLACE_WITH_DATABASE_PORT

# Bootstrap/migrations. Do not inject these credentials into the API container.
POSTGRES_ADMIN_USER=REPLACE_WITH_LOCAL_ADMIN_USER
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD

# Ingestion process; limited write privileges.
POSTGRES_INGEST_USER=REPLACE_WITH_LOCAL_INGEST_USER
POSTGRES_INGEST_PASSWORD=REPLACE_WITH_LOCAL_INGEST_PASSWORD

# API and agent process; read-only database privileges.
POSTGRES_READ_USER=REPLACE_WITH_LOCAL_READ_USER
POSTGRES_READ_PASSWORD=REPLACE_WITH_LOCAL_READ_PASSWORD

# Optional API settings; defaults shown. Ten years is a request-width limit, not retention.
API_PORT=8000
API_MAX_WINDOW_DAYS=3653
API_STALE_AFTER_SECONDS=900

# Optional agent: disabled until a model/key and live-demo spending are chosen.
# Supply only to the API process. Never share actual values or paste keys into chat.
AGENT_ENABLED=false
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=REPLACE_WITH_CHOSEN_FUNCTION_CAPABLE_MODEL
AGENT_DEADLINE_SECONDS=60
AGENT_MAX_MODEL_REQUESTS=4
AGENT_MAX_TOOL_CALLS=3
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_MAX_QUESTION_CHARS=4000
AGENT_MAX_ANSWER_CHARS=8000
AGENT_MAX_CONTEXT_BYTES=128000
AGENT_MAX_TOOL_OUTPUT_BYTES=32000
AGENT_MAX_RESPONSE_BYTES=64000
